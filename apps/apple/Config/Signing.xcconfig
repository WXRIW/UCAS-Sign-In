// Version.xcconfig is generated from eng/version.json.
#include "../../../eng/generated/Version.xcconfig"

// Shared defaults for simulator builds. Configure device signing in the local file.
DEVELOPMENT_TEAM =
APP_BUNDLE_IDENTIFIER = cn.ucas.signin
// Override only this value for an iOS app with a separate distribution identity.
IOS_APP_BUNDLE_IDENTIFIER = $(APP_BUNDLE_IDENTIFIER)
APP_GROUP_IDENTIFIER = group.cn.ucas.signin

// macOS uses a Team-prefixed group. The suffix is shared by the Mac app and widget.
MAC_APP_GROUP_SUFFIX = cn.ucas.signin

// Both main apps use one private CloudKit database and synchronizable keychain group.
ICLOUD_CONTAINER_IDENTIFIER = iCloud.$(APP_BUNDLE_IDENTIFIER)
ICLOUD_KEYCHAIN_ACCESS_GROUP = $(AppIdentifierPrefix)$(APP_BUNDLE_IDENTIFIER).icloud-credentials
// Distribution packaging explicitly overrides this to Production.
ICLOUD_CONTAINER_ENVIRONMENT = Development
// Main apps receive CloudKit silent pushes. Distribution packaging uses production.
APS_ENVIRONMENT = development

// Optional, ignored by Git. See Signing.local.xcconfig.example.
#include? "Signing.local.xcconfig"
